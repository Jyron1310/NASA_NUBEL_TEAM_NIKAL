# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube al repositorio.

# Modo de datos: synthetic (simulador, por defecto) | real (CSV de FIRMS + API NRT)
FIRECAL_DATA_MODE=synthetic

# MAP_KEY de FIRMS (solo modo real). Se obtiene en https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Código de la región de trabajo (GeoJSON en config/regions/)
FIRECAL_REGION=peru_sur

# Fuerza UTF-8 en Python (Windows usa cp1252 por defecto). OJO: debe estar en el
# entorno ANTES de arrancar Python; en PowerShell: $env:PYTHONUTF8 = "1"
PYTHONUTF8=1

# Opcionales
# FIRECAL_HOME=.                  # raíz del proyecto (por defecto, la carpeta del repo)
# FIRECAL_CONFIG=config/settings.yaml
# FIRECAL_LOG_LEVEL=INFO
# FIRECAL_API_HOST=127.0.0.1
# FIRECAL_API_PORT=8000

# Orígenes extra para CORS (frontend publicado en otro dominio), separados por comas
# FIRECAL_CORS_ORIGINS=https://<proyecto>.vercel.app
